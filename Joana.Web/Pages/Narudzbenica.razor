@page "/narudzbenica"
@using Joana.Web.Extension
@inject ApiService Api
@inject AuthService Auth
@inject CartService Cart
@inject NavigationManager Nav

<PageTitle>Kreiranje narudžbenice</PageTitle>

<h1>Kreiranje narudžbenice</h1>

@if (isSubmitted)
{
    <div class="alert alert-success">Narudžbenica je uspešno kreirana.</div>
    <a class="btn btn-primary" href="/moje-narudzbenice">Moje narudžbenice</a>
}
else if (Cart.Items.Count == 0)
{
    <p>Korpa je prazna. Dodajte proizvode pre kreiranja narudžbenice.</p>
    <a class="btn btn-primary" href="/">Nazad na katalog</a>
}
else
{
    <table class="table">
        <thead>
            <tr><th>Proizvod</th><th>Količina</th><th>Cena</th><th>Ukupno</th></tr>
        </thead>
        <tbody>
            @foreach (var item in Cart.Items)
            {
                <tr>
                    <td>@item.Naziv</td>
                    <td>@item.Kolicina</td>
                    <td>@item.Cena.ToRsd()</td>
                    <td>@item.Ukupno.ToRsd()</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-end">Ukupno:</th>
                <th>@Cart.Total.ToRsd()</th>
            </tr>
        </tfoot>
    </table>

    <div class="mb-3 col-md-6">
        <label class="form-label" for="napomena">Napomena</label>
        <textarea id="napomena" class="form-control" rows="3" @bind="napomena"></textarea>
    </div>

    @if (errorMessage is not null)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <button class="btn btn-primary" disabled="@isSubmitting" @onclick="PosaljiNarudzbenicu">
        @(isSubmitting ? "Slanje..." : "Pošalji narudžbenicu")
    </button>
}

@code {
    private string? napomena;
    private string? errorMessage;
    private bool isSubmitting;
    private bool isSubmitted;

    protected override async Task OnInitializedAsync()
    {
        if (!await Auth.IsLoggedInAsync())
        {
            Nav.NavigateTo("/login");
        }
    }

    private async Task PosaljiNarudzbenicu()
    {
        errorMessage = null;

        var kupacId = await Auth.GetKupacIdAsync();
        if (kupacId is null)
        {
            errorMessage = "Morate biti prijavljeni da biste kreirali narudžbenicu.";
            return;
        }

        isSubmitting = true;

        var dto = new CreateNarudzbenicaModel
        {
            IdKupac = kupacId.Value,
            NapomenaKupca = napomena,
            Stavke = Cart.Items.Select(i => new CreateStavkaNarudzbeniceModel
            {
                IdProizvod = i.ProizvodId,
                Kolicina = i.Kolicina,
                UgovorenaCena = i.Cena
            }).ToList()
        };

        var result = await Api.PostAsync<CreateNarudzbenicaModel, NarudzbenicaModel>("api/narudzbenica", dto);

        isSubmitting = false;

        if (result.Success)
        {
            Cart.Clear();
            isSubmitted = true;
        }
        else
        {
            errorMessage = result.ErrorMessage;
        }
    }
}
