@page "/login"
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Prijava</PageTitle>

<h1>Prijava</h1>

<EditForm Model="loginModel" OnValidSubmit="HandleLogin" class="col-md-4">
    <div class="mb-3">
        <label class="form-label" for="email">Email</label>
        <InputText id="email" class="form-control" @bind-Value="loginModel.Email" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="lozinka">Lozinka</label>
        <InputText id="lozinka" type="password" class="form-control" @bind-Value="loginModel.Lozinka" />
    </div>

    @if (errorMessage is not null)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
        @(isSubmitting ? "Prijavljivanje..." : "Prijavi se")
    </button>
</EditForm>

<p class="mt-3">Nemate nalog? <a href="/registracija">Registrujte se</a></p>

@code {
    private LoginModel loginModel = new();
    private string? errorMessage;
    private bool isSubmitting;

    protected override async Task OnInitializedAsync()
    {
        if (await Auth.IsLoggedInAsync())
        {
            Nav.NavigateTo("/");
        }
    }

    private async Task HandleLogin()
    {
        errorMessage = null;
        isSubmitting = true;

        var result = await Auth.LoginAsync(loginModel.Email, loginModel.Lozinka);

        isSubmitting = false;

        if (result.Success)
        {
            Nav.NavigateTo("/");
        }
        else
        {
            errorMessage = result.ErrorMessage;
        }
    }
}
